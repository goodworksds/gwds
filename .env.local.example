# Copy this file to .env.local and fill in real values.

# MongoDB connection string.
# Local: mongodb://127.0.0.1:27017/goodworks
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/goodworks?retryWrites=true&w=majority
MONGODB_URI=

# Resend (https://resend.com) API key used to email the team on every
# contact form submission.
RESEND_API_KEY=

# Optional overrides — sensible defaults are baked in if left blank.
# CONTACT_EMAIL_TO defaults to admin@goodworksdisabilityservices.com.au
# CONTACT_EMAIL_CC defaults to goodworksds@gmail.com
# CONTACT_EMAIL_FROM must be an address on a domain verified at
# resend.com/domains. Until goodworksdisabilityservices.com.au is verified
# there, Resend runs in sandbox mode and can only deliver to the email
# address the Resend account itself was signed up with — nothing else,
# not even as CC.
CONTACT_EMAIL_TO=
CONTACT_EMAIL_CC=
CONTACT_EMAIL_FROM=

# Admin dashboard (/admin) — lists contact form submissions from MongoDB
# with delete and email-reply actions. Both are required for /admin to work.
# ADMIN_PASSWORD: the password used to log in at /admin/login. Choose your own.
# ADMIN_SESSION_SECRET: a long random string used to sign the login session
# cookie so it can't be forged. Generate one with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
